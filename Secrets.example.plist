<?xml version="1.0" encoding="UTF-8"?>
<!--
  Copy this file to  Routly/Secrets.plist  (that path is gitignored),
  fill in ONE provider below, and rebuild. With nothing set, the app runs on the
  offline stub parser — which merges tasks and produces rough titles.

  ── Option A: any OpenAI-compatible provider (DeepSeek, Qwen, OpenRouter, Groq,
     or a local model). Set AIBaseURL + AIModel, and AIAPIKey unless it's local.
     This takes priority over the Anthropic key below.

       DeepSeek        AIBaseURL  https://api.deepseek.com/v1
                       AIModel    deepseek-chat

       Qwen (DashScope, international endpoint)
                       AIBaseURL  https://dashscope-intl.aliyuncs.com/compatible-mode/v1
                       AIModel    qwen-plus          (or qwen-turbo — cheaper/faster)

       OpenRouter      AIBaseURL  https://openrouter.ai/api/v1
                       AIModel    deepseek/deepseek-chat        (some models have :free variants)

       Groq            AIBaseURL  https://api.groq.com/openai/v1
                       AIModel    openai/gpt-oss-120b   (llama-3.3-70b-versatile was decommissioned)

       Local (Ollama)  AIBaseURL  http://localhost:11434/v1
                       AIModel    qwen2.5:7b
                       AIAPIKey   (leave empty)
                       ⚠️ Plain http needs an App Transport Security exception,
                          and only works in the Simulator or on the same network.

  ── Option B: Anthropic. Set AnthropicAPIKey only.

  ⚠️ A key bundled in the app is extractable from the binary — dev use only.
     Before shipping, route parsing through a backend proxy instead.

  ── Accounts (optional): Supabase project URL + anon key.
     With both set, the account screen offers email sign-in. (Sign in with
     Apple is off — it needs a paid Apple Developer membership; see the docs.)
     With either missing, the app stays in guest mode permanently and every
     feature still works — sign-in simply isn't offered.

       SupabaseURL      https://<project-ref>.supabase.co
       SupabaseAnonKey  <the publishable anon key>

     Unlike the AI keys above, the anon key is *designed* to be public — it
     identifies the project and Row Level Security is what protects the data.
     Setup steps are in Docs/supabase-auth-setup.md.

  ── Google Calendar (optional): the iOS OAuth client ID.
     With it set, Settings → Calendars offers Google alongside Apple. Without
     it, Google is absent entirely and Apple Calendar still works.

       GoogleClientID   1234567890-abcdefg.apps.googleusercontent.com

     Like the Supabase anon key, this is public by design: an iOS OAuth client
     is issued no secret at all, and PKCE is what proves the token request came
     from this app. Setup steps are in docs/google-calendar-setup.md.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>AIBaseURL</key>
	<string></string>
	<key>AIModel</key>
	<string></string>
	<key>AIAPIKey</key>
	<string></string>

	<key>AnthropicAPIKey</key>
	<string></string>

	<key>SupabaseURL</key>
	<string></string>
	<key>SupabaseAnonKey</key>
	<string></string>

	<key>GoogleClientID</key>
	<string></string>
</dict>
</plist>
