    "Routine Organizer keeps your schedule on this phone. Capture by voice is transcribed on device wherever the language allows it, and an account, if you make one, only adds a backup.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Routine Organizer guarda tu agenda en este teléfono. La captura por voz se transcribe en el dispositivo siempre que el idioma lo permita, y una cuenta, si la creas, solo añade una copia de seguridad."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Routine Organizer guarda sua agenda neste telefone. A captura por voz é transcrita no dispositivo sempre que o idioma permitir, e uma conta, se você criar, apenas adiciona um backup."
          }
        }
      }
    },
    "Routine Organizer works fully offline. An account only adds a backup — it never gates a feature.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Routine Organizer funciona sin conexión. Una cuenta solo añade una copia de seguridad; nunca bloquea ninguna función."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Routine Organizer funciona totalmente offline. Uma conta só adiciona um backup — nunca bloqueia nenhum recurso."
          }
        }
      }
    },
    "Routly built an address Google couldn't read.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Routly built an address Google couldn't read."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Routly generó una dirección que Google no pudo leer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Routly gerou um endereço que o Google não conseguiu ler."
          }
        }
      }
    },
    "Routly can add events here but can't change or remove them. Allow full access in the Settings app to keep them in step.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Routly can add events here but can't change or remove them. Allow full access in the Settings app to keep them in step."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Routly puede añadir eventos aquí, pero no puede cambiarlos ni eliminarlos. Permite el acceso completo en la app Ajustes para mantenerlos sincronizados."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Routly pode adicionar eventos aqui, mas não pode alterá-los nem removê-los. Permita o acesso total no app Ajustes para mantê-los em dia."
          }
        }
      }
    },
    "Routly can add events here. Turn on “Add new events here” and every new event will go automatically.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Routly can add events here. Turn on “Add new events here” and every new event will go automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Routly puede añadir eventos aquí. Activa “Añadir aquí los eventos nuevos” y todos los eventos nuevos irán automáticamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Routly pode adicionar eventos aqui. Ative “Adicionar novos eventos aqui” e todos os novos eventos irão automaticamente."
          }
        }
      }
    },
    "Routly can add to this calendar but can't change or remove what it added. Full calendar access is needed for that.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Routly can add to this calendar but can't change or remove what it added. Full calendar access is needed for that."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Routly puede añadir a este calendario, pero no puede cambiar ni eliminar lo que añadió. Para eso hace falta acceso completo al calendario."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Routly pode adicionar a este calendário, mas não pode alterar nem remover o que adicionou. Para isso é preciso acesso total ao calendário."
          }
        }
