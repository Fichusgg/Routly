            "state": "translated",
            "value": "Este mês"
          }
        }
      }
    },
    "This permanently deletes the account. Your schedule stays on this phone and the app keeps working.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina la cuenta de forma permanente. Tu agenda se queda en este teléfono y la app sigue funcionando."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto exclui a conta permanentemente. Sua agenda continua neste telefone e o app segue funcionando."
          }
        }
      }
    },
    "This phone has %lld items and your account has %lld. How should they come together?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This phone has %#@items@ and your account has %2$lld. How should they come together?"
          },
          "substitutions": {
            "items": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg item"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg items"
                    }
                  }
                }
              }
            }
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este teléfono tiene %#@items@ y tu cuenta tiene %2$lld. ¿Cómo deberían juntarse?"
          },
          "substitutions": {
            "items": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg elemento"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg elementos"
                    }
                  }
                }
              }
            }
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este telefone tem %#@items@ e sua conta tem %2$lld. Como eles devem se juntar?"
          },
          "substitutions": {
            "items": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg item"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg itens"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "This phone has no offline model for %@, so recordings in it would be sent to Apple to be transcribed. Nothing else about your schedule leaves the device.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este teléfono no tiene modelo sin conexión para %@, así que las grabaciones en ese idioma se enviarían a Apple para transcribirlas. Nada más de tu agenda sale del dispositivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este telefone não tem modelo offline para %@, então as gravações nesse idioma seriam enviadas à Apple para transcrição. Nada mais da sua agenda sai do aparelho."
          }
        }
      }
    },
    "This phone has no offline model for %@. With this off, voice capture won't work in that language.": {
      "localizations": {
