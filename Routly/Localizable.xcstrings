    "“%@” runs right into “%@” with no buffer. Add a gap?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” enlaza directamente con “%@” sin margen. ¿Añadir un hueco?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” emenda direto em “%@” sem intervalo. Adicionar uma folga?"
          }
        }
      }
    },
    "“%@” — %@. Deleting everything ahead stops it filling future days; deleting every occurrence also clears its history.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» — %@. Eliminar todo lo siguiente evita que ocupe días futuros; eliminar todas las repeticiones también borra su historial."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” — %@. Excluir tudo o que vem depois evita que ocupe dias futuros; excluir todas as ocorrências também apaga o histórico."
          }
        }
      }
    },
    "…and %lld more that won't fit today.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "…and %lld more that won't fit today."
                }
              },
              "other": {
