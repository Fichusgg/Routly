    "Your %@ live only on this phone. Sign in to keep them if it's lost or replaced.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus %@ solo existen en este teléfono. Inicia sesión para conservarlos si lo pierdes o lo cambias."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus %@ existem só neste telefone. Entre para mantê-los se ele for perdido ou trocado."
          }
        }
      }
    },
    "Your captures stay on this phone. They're read here by simple pattern-matching, which can merge two tasks into one or get a title wrong.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus capturas se quedan en este teléfono. Se leen aquí con reglas sencillas, que pueden juntar dos tareas en una o equivocarse con un título."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas capturas ficam neste telefone. Elas são lidas aqui por regras simples, que podem juntar duas tarefas em uma ou errar um título."
          }
        }
      }
    },
